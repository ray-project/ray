# native_runtime - Composite library combining all bridge libraries for backward compatibility.
# This is a convenience library that re-exports all necessary dependencies for Go runtime.
# It does not contain any source files or headers - all implementation is in the bridge libraries.
# Go code includes headers directly via CGO #include directives.
#
# Note: All other dependencies (cgo_wrapper, runtime_ops, etc.) are transitively provided
# by the bridge libraries. No need to list them explicitly.
#
# Note: Includes runtime_stubs.cc to provide stub implementations of Go-exported functions
# when the Go runtime is not available. This allows C++ code to compile without Go.
#
# Note: Define GRPC_EXPERIMENTS=0 to disable gRPC experiments flag (fixes plugin loading issue)
ray_cc_library(
    name = "native_runtime",
    # No srcs - all implementation is in bridge libraries
    # No hdrs - Go code includes headers directly via CGO #include directives
    srcs = ["runtime_stubs.cc"],  # Stub implementations for Go functions
    copts = ["-DGRPC_EXPERIMENTS=0"],  # Disable gRPC experiments to avoid plugin loading conflicts
    visibility = ["//go:__subpackages__"],
    deps = [
        # All bridge libraries (CGO boundary layer)
        # These provide all necessary transitive dependencies
        ":native_runtime_bridge",
        ":native_object_store_bridge",
        ":native_worker_context_bridge",
        ":native_task_submitter_bridge",
        ":native_task_executor_bridge",
    ],
)
