load("@rules_python//python:defs.bzl", "py_test")
load("@rules_rust_pyo3//:defs.bzl", "pyo3_extension")

pyo3_extension(
    name = "ray_probe_ext",
    srcs = ["ray_probe_ext.rs"],
    edition = "2021",
)

# Consuming the .so as a data file, the shape Ray uses for _raylet.so. Kept
# alongside ray_probe_ext_deps_test below, which uses the normal deps form.
py_test(
    name = "ray_probe_ext_test",
    tags = ["team:core"],
    srcs = ["ray_probe_ext_test.py"],
    data = [":ray_probe_ext"],
)

# With rules_python unified in MODULE.bazel (one PyInfo for both dependency
# systems), the extension is an ordinary deps edge.
py_test(
    name = "ray_probe_ext_deps_test",
    srcs = ["ray_probe_ext_deps_test.py"],
    deps = [":ray_probe_ext"],
)
