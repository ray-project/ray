load("@py_deps_py310//:requirements.bzl", ci_require = "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "trivy_report",
    srcs = ["trivy_report.py"],
)

py_test(
    name = "test_trivy_report",
    size = "small",
    srcs = ["test_trivy_report.py"],
    data = glob(["testdata/*.json"]),
    exec_compatible_with = ["//bazel:py3"],
    tags = [
        "ci_unit",
        "team:ci",
    ],
    deps = [
        ":trivy_report",
        ci_require("pytest"),
    ],
)

py_library(
    name = "scan_store",
    srcs = ["scan_store.py"],
    deps = [
        ci_require("boto3"),
        ci_require("botocore"),
        ci_require("click"),
    ],
)

py_library(
    name = "fake_s3",
    testonly = True,
    srcs = ["fake_s3.py"],
    deps = [ci_require("botocore")],
)

py_test(
    name = "test_scan_store",
    size = "small",
    srcs = ["test_scan_store.py"],
    exec_compatible_with = ["//bazel:py3"],
    tags = [
        "ci_unit",
        "team:ci",
    ],
    deps = [
        ":fake_s3",
        ":scan_store",
        ci_require("click"),
        ci_require("pytest"),
    ],
)

py_test(
    name = "test_workspace_contexts",
    size = "small",
    srcs = ["test_workspace_contexts.py"],
    data = [
        "//:WORKSPACE",
        "//:ci/docker/ray-core.wanda.yaml",
        "//:ci/docker/ray-cpp-core.wanda.yaml",
        "//:ci/docker/ray-java.wanda.yaml",
    ],
    exec_compatible_with = ["//bazel:py3"],
    tags = [
        "ci_unit",
        "team:ci",
    ],
    deps = [
        ci_require("bazel-runfiles"),
        ci_require("pytest"),
        ci_require("pyyaml"),
    ],
)
