load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# Public API library for Ray Go Runtime
# Consistent with Java Ray API (io.ray.api.Ray)
go_library(
    name = "api",
    srcs = [
        "actor.go",
        "api.go",
        "call.go",
        "factory.go",
        "gcs_client.go",  # NEW: GCS client interface and factory
        "handle.go",
        "method_extractor.go",
        "object.go",
        "object_id_generator.go",
        "options.go",
        "ray.go",
        "runtime.go",
    ],
    importpath = "github.com/ray-project/ray/go/pkg/runtime/api",
    visibility = ["//visibility:public"],
    deps = [
        "//go/pkg/errors",
        "//go/pkg/gcs",
        "//go/pkg/ids",
        "//go/pkg/log",
        "//go/pkg/options",
        "//go/pkg/pathutil",
        "//go/pkg/runtime/contract",
        "//go/pkg/runtime/function",
        "//go/pkg/runtime/object",
        "//go/pkg/runtime/plugin",
        "//go/pkg/runtime/submitter",
        "//go/proto",
        "@org_golang_google_protobuf//proto",
    ],
)

# Unit tests for API
go_test(
    name = "api_test",
    srcs = [
        "api_test.go",
        "handle_release_test.go",
        "example_test.go",
        "object_ref_test.go",
    ],
    embed = [":api"],
    deps = [
        "//go/pkg/errors",
        "//go/pkg/ids",
        "//go/pkg/runtime/contract",
        "//go/pkg/runtime/object",
    ],
)
