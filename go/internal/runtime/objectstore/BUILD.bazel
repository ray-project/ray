load("@io_bazel_rules_go//go:def.bzl", "go_library")

# Object store implementations.
# This package contains concrete implementations of the ObjectStore interface:
# - NativeObjectStore: CGO-based implementation using the C++ Ray core worker.
# - LocalModeObjectStore: Pure Go in-memory implementation for local mode.
go_library(
    name = "objectstore",
    srcs = [
        "local_mode_object_store.go",
        "native_object_store.go",
    ],
    cdeps = [
        "//src/ray/core_worker/lib/go:native_runtime",
        "//src/ray/core_worker/lib/go:native_runtime_go_headers",
    ],
    cgo = True,
    importpath = "github.com/ray-project/ray/go/internal/runtime/objectstore",
    visibility = ["//visibility:public"],
    deps = [
        "//go/pkg/ids",
        "//go/pkg/runtime/object",
        "//go/proto",
        "@org_golang_google_protobuf//proto",
    ],
)
