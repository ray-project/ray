load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# base package provides the foundation types and interfaces for Ray Go Runtime
# This includes:
# - Runtime interface
# - RuntimeFactory interface
# - InitializeOptions and WorkerType types
# - WorkerContext interface
#
# Note: the base package depends on no other runtime subpackage, avoiding circular deps
go_library(
    name = "base",
    srcs = [
        "context.go",  # WorkerContext interface and TaskType constants
        "factory.go",  # RuntimeFactory interface
        "handle.go",  # RuntimeHandle interface and implementation
        "options.go",  # InitializeOptions and conversion functions
        "runtime.go",  # Runtime interface (re-export from contract)
        "runtime_manager.go",  # Runtime singleton management and Initialize/Shutdown functions
    ],
    importpath = "github.com/ray-project/ray/go/internal/runtime/base",
    visibility = ["//visibility:public"],
    deps = [
        "//go/internal/common",
        "//go/internal/errors",
        "//go/pkg/log",
        "//go/pkg/options",
        "//go/pkg/runtime/contract",  # Added dependency on contract package
        "//go/pkg/runtime/object",
    ],
)

# base package unit tests
go_test(
    name = "base_test",
    srcs = ["options_test.go"],
    embed = [":base"],
    importpath = "github.com/ray-project/ray/go/internal/runtime/base",
    deps = ["//go/pkg/options"],
)
