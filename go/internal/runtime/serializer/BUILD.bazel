load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# Internal serializer package - provides low-level serialization implementation
# This package is internal and cannot be accessed from outside the ray/go module
go_library(
    name = "serializer",
    srcs = [
        "buffer_pool_wrapper.go",
        "context.go",
        "extension.go",
        "msgpack_serializer.go",
        "object_serializer_impl.go",
        "serializer.go",
        "tiered_buffer_pool.go",
        "type_utils.go",
        "zero_copy.go",
    ],
    importpath = "github.com/ray-project/ray/go/internal/runtime/serializer",
    visibility = [
        "//go:__pkg__",  # For test_args_main.go
        "//go/cmd/plugin:__pkg__",
        "//go/internal/runtime/local_mode:__pkg__",
        "//go/internal/runtime/native:__pkg__",
        "//go/internal/worker:__pkg__",  # For wrapGoFunction to access serializer
    ],
    deps = [
        "//go/pkg/ids",
        "//go/pkg/log",
        "//go/pkg/runtime/object",
        "@com_github_vmihailenco_msgpack_v5//:msgpack",
    ],
)

# Unit tests for serializer package
go_test(
    name = "serializer_test",
    srcs = [
        "context_test.go",
        "msgpack_serializer_test.go",
        "serializer_test.go",
        "tiered_buffer_pool_bench_test.go",
        "tiered_buffer_pool_test.go",
        "type_utils_test.go",
        "zero_copy_test.go",
    ],
    embed = [":serializer"],
    deps = ["//go/pkg/ids"],
)
