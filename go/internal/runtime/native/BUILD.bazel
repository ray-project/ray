load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# native package provides native implementation of Ray Runtime
# This package implements the core.Runtime interface and uses coreworker package
go_library(
    name = "native",
    srcs = [
        "native_runtime.go",  # NativeRuntime implementation
        "runtime_context_impl.go",  # GCS query implementations and conversion helpers
    ],
    importpath = "github.com/ray-project/ray/go/internal/runtime/native",
    visibility = ["//visibility:public"],
    deps = [
        "//go/internal/gcs/native",
        "//go/internal/runtime/base",
        "//go/internal/runtime/cgo",
        "//go/internal/runtime/objectstore",  # Added for objectstore.NativeObjectStore
        "//go/internal/runtime/resource",
        "//go/internal/runtime/serializer",
        "//go/pkg/gcs",
        "//go/pkg/ids",
        "//go/pkg/log",
        "//go/pkg/options",
        "//go/pkg/runtime/api",
        "//go/pkg/runtime/contract",
        "//go/pkg/runtime/function",
        "//go/pkg/runtime/object",
        "//go/pkg/runtime/submitter",
        "//go/proto",
    ],
)

