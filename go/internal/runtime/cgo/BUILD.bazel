load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# cgo 包 - CGO 绑定集中在这里
# 所有子目录已合并到单一包中
go_library(
    name = "cgo",
    srcs = [
        # Utils layer - Shared utilities
        "converters.go",  # CGO helper functions
        # Boundary layer - CGO boundary handling
        "coreworker.go",  # CoreWorker lifecycle management
        # Memory layer - Memory management
        "native_allocator.go",  # Go-side object allocation callback
        # Interfaces layer - Interface implementations
        "native_context.go",  # WorkerContext bindings
        "native_executor.go",  # TaskExecutor bindings
        "native_submitter.go",  # TaskSubmitter bindings
        # Callback layer - Called by C++
        "task_executor.go",  # Go-side task execution callback
    ],
    cdeps = [
        "//src/ray/core_worker/lib/go:native_runtime_go_headers",
        "//src/ray/core_worker/lib/go:native_runtime",
    ],
    cgo = True,
    importpath = "github.com/ray-project/ray/go/internal/runtime/cgo",
    visibility = ["//visibility:public"],
    deps = [
        "//go/internal/errors",
        "//go/internal/runtime/base",
        "//go/pkg/ids",
        "//go/pkg/log",
        "//go/pkg/runtime/function",
        "//go/pkg/runtime/object",
        "//go/pkg/runtime/submitter",
    ],
)

