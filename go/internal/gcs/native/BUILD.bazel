# Benchmark 测试 - 使用 go test -bench=. -run=^$ 运行
# 注意：benchmark 文件属于 package native，不是 package main，因此必须是 go_test 而不是 go_binary
go_test(
    name = "benchmarks",
    srcs = ["client_cgo_benchmark.go"],
    cgo = True,
    importpath = "github.com/ray-project/ray/go/internal/gcs/native",
    tags = ["benchmark"],
    deps = [
        "//go/pkg/gcs",
        "//go/pkg/ids",
    ],
)
