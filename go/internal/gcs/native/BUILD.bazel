load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# 主 native 库（包含 benchmark）
go_library(
    name = "native",
    srcs = [
        "async.go",
        "autoscaler_cgo.go",
        "client_cgo.go",
        "client_cgo_benchmark.go",
        "config.go",
        "nodes_cgo.go",
        "publisher_cgo.go",
        "subscriber_cgo.go",
    ],
    cdeps = ["//src/ray/core_worker/lib/go:gcs_client_bridge"],
    cgo = True,
    importpath = "github.com/ray-project/ray/go/internal/gcs/native",
    visibility = ["//go:__subpackages__"],
    deps = [
        "//go/pkg/gcs",
        "//go/pkg/ids",
        "//go/pkg/log",
        "//go/proto",
        "@org_golang_google_protobuf//proto",
    ],
)

