load("@rules_python//python:defs.bzl", "py_library")
load("//bazel:python.bzl", "py_test_module_list")

py_library(
    name = "sandbox_lib",
    srcs = glob(
        ["**/*.py"],
        exclude = ["tests/**/*.py"],
    ),
    visibility = [
        "//python/ray/experimental/sandbox:__pkg__",
        "//python/ray/experimental/sandbox:__subpackages__",
        "//release:__pkg__",
    ],
    deps = [
        "//:ray_lib",
    ],
)

py_library(
    name = "conftest",
    srcs = ["tests/conftest.py"],
    deps = [
        "//python/ray/tests:conftest",
    ],
)

py_test_module_list(
    size = "medium",
    files = glob(
        ["tests/**/*.py"],
        exclude = [
            "tests/conftest.py",
            "tests/__init__.py",
            "tests/test_gvisor_gpu.py",
            "tests/test_gvisor_multi_gpu.py",
        ],
    ),
    tags = [
        "sandbox_tests",
        "team:core",
    ],
    deps = [
        ":conftest",
        ":sandbox_lib",
    ],
)

# Needs a real GPU + nvidia-ctk. Only scheduled on a GPU CI runner -- see
# .buildkite/core.rayci.yml's "core: sandbox gpu tests" job. These pull a
# CUDA base image plus the cuda-sample image and boot gVisor with
# nvproxy, so size=large gives a slow registry enough headroom not to
# show up as a flaky timeout.
py_test_module_list(
    size = "large",
    files = ["tests/test_gvisor_gpu.py"],
    tags = [
        "gpu",
        "sandbox_tests",
        "team:core",
    ],
    deps = [
        ":conftest",
        ":sandbox_lib",
    ],
)

# Needs 4 real GPUs + nvidia-ctk. Only scheduled on a gpu-large CI runner --
# see .buildkite/core.rayci.yml's "core: sandbox multi-gpu tests" job.
# These pull a CUDA base image plus the cuda-sample image and boot gVisor
# with nvproxy, so size=large gives a slow registry enough headroom not
# to show up as a flaky timeout.
py_test_module_list(
    size = "large",
    files = ["tests/test_gvisor_multi_gpu.py"],
    tags = [
        "multi_gpu",
        "sandbox_tests",
        "team:core",
    ],
    deps = [
        ":conftest",
        ":sandbox_lib",
    ],
)
