load("@rules_python//python:defs.bzl", "py_library")
load("//bazel:python.bzl", "py_test_module_list")

py_library(
    name = "sandbox_lib",
    srcs = glob(
        ["**/*.py"],
        # modal/tests lives inside the package, so it must be excluded here
        # too or its test modules ship inside the library.
        exclude = [
            "tests/**/*.py",
            "modal/tests/**/*.py",
        ],
    ),
    visibility = [
        "//python/ray/experimental/sandbox:__pkg__",
        "//python/ray/experimental/sandbox:__subpackages__",
        "//release:__pkg__",
    ],
    deps = [
        "//:ray_lib",
    ],
)

py_library(
    name = "conftest",
    srcs = ["tests/conftest.py"],
    deps = [
        "//python/ray/tests:conftest",
    ],
)

py_test_module_list(
    size = "medium",
    files = glob(
        ["tests/**/*.py"],
        exclude = [
            "tests/conftest.py",
            "tests/__init__.py",
        ],
    ),
    tags = [
        "sandbox_tests",
        "team:core",
    ],
    deps = [
        ":conftest",
        ":sandbox_lib",
    ],
)

# Tests for the Modal-compatible layer that need neither runsc nor a Ray
# cluster. They live outside tests/ so that directory's conftest -- which skips
# everything unless TEST_SANDBOX=1 and downloads runsc -- does not apply, and
# they therefore run with plain pytest as well as in CI.
py_test_module_list(
    size = "small",
    files = glob(
        ["modal/tests/**/*.py"],
        exclude = ["modal/tests/__init__.py"],
    ),
    tags = [
        # Deliberately NOT "sandbox_tests": that tag marks the suites needing
        # runsc, and CI selectors that skip it where runsc is unavailable would
        # otherwise skip these too -- defeating the point of keeping them
        # runsc-free.
        "sandbox_unit_tests",
        "team:core",
    ],
    deps = [
        ":sandbox_lib",
    ],
)
