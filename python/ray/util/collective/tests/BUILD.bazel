load("@rules_python//python:defs.bzl", "py_library")
load("//bazel:python.bzl", "py_test_module_list")

py_library(
    name = "conftest",
    srcs = ["conftest.py"],
    deps = ["//:ray_lib"],
)

# Hardware-free tests. The multi-process CPU/GPU/XPU suites need dedicated
# hardware and are not run here.
py_test_module_list(
    size = "small",
    files = [
        "test_xccl_unit.py",
    ],
    tags = [
        "exclusive",
        "team:core",
    ],
    deps = [
        ":conftest",
        "//:ray_lib",
    ],
)
