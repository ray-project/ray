 from typing import TYPE_CHECKING
@@ -37,6 +38,26 @@ if TYPE_CHECKING:
 _logger = AIPerfLogger(__name__)


+def _closed_loop_turn_concurrency_enabled() -> bool:
+    """Whether the prefill limiter is acting as a whole-turn limiter.
+
+    Normal AIPerf semantics deliberately release a prefill slot at first token:
+    the limiter bounds prompt work, not streaming generations. The agentic
+    routing benchmark needs a different, explicitly opt-in contract: a client
+    slot is held from request dispatch through the final streamed token. We
+    reuse the existing all-turn acquisition path and alter only release timing,
+    so roots, DAG children, and join turns are all covered by one global limit.
+    """
+    return os.environ.get(
+        "AIPERF_CLOSED_LOOP_TURN_CONCURRENCY", ""
+    ).strip().lower() in {
+        "1",
+        "true",
+        "yes",
+        "on",
+    }
+
+
 @dataclass(slots=True)
 class PhaseCallbackContext:
     """Context for handling callbacks for a specific phase.
@@ -641,9 +662,14 @@ class CreditCallbackHandler:
                 for _ in range(in_flight):
                     concurrency.release_session_slot(phase)

-        # Prefill slot is normally released on TTFT. If the request failed or was
-        # cancelled before first token, we release here to prevent slot leaks.
-        if not credit_return.first_token_sent:
+        # A normal prefill slot is released at TTFT. In the explicit
+        # closed-loop-turn mode it instead represents a client request slot,
+        # which must remain held until the final streamed token. Requests that
+        # fail before TTFT still release here in both modes.
+        if (
+            _closed_loop_turn_concurrency_enabled()
+            or not credit_return.first_token_sent
+        ):
             concurrency.release_prefill_slot(phase)

     async def on_first_token(self, first_token: FirstToken) -> None:
@@ -672,5 +698,9 @@ class CreditCallbackHandler:
         # Track the release
         handler.progress.increment_prefill_released()

-        # Release the prefill slot
-        handler.concurrency_manager.release_prefill_slot(key)
+        # Under the opt-in closed-loop contract this is only a prefill-complete
+        # accounting event. The request slot releases in ``on_credit_return``
+        # after the final streamed token, preserving exactly N in-flight client
+        # requests across roots, children, and join turns.
+        if not _closed_loop_turn_concurrency_enabled():
+            handler.concurrency_manager.release_prefill_slot(key)
