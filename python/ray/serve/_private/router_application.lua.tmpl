-- Routes a held request using an application and replica decision.

local DIRECT_RESPONSE_HEADER = "${DIRECT_RESPONSE_HEADER}"

-- router backend -> { app, p = route prefix, pool = replicas or fallback proxy }
local ROUTERS = ${ROUTERS}

-- app name -> { b = backend, p = route prefix, d = ingress deployment, r = { replica_id = server } }
local APPS = ${APPS}

local _rr_cursor = {}

local RESPONSE_HEADER_BLOCKLIST = {
    [DIRECT_RESPONSE_HEADER] = true,
    ["connection"] = true,
    ["content-length"] = true,
    ["keep-alive"] = true,
    ["proxy-authenticate"] = true,
    ["proxy-authorization"] = true,
    ["proxy-connection"] = true,
    ["te"] = true,
    ["trailer"] = true,
    ["transfer-encoding"] = true,
    ["upgrade"] = true,
}

local function copy_response_headers(reply, head)
    local connection_headers = {}
    for name, value in head:gmatch("\r\n([^:\r\n]+):%s*([^\r\n]*)") do
        if name:lower() == "connection" then
            for token in value:gmatch("[^,]+") do
                connection_headers[token:match("^%s*(.-)%s*$$"):lower()] = true
            end
        end
    end

    local has_content_type = false
    for name, value in head:gmatch("\r\n([^:\r\n]+):%s*([^\r\n]*)") do
        local lower_name = name:lower()
        if not RESPONSE_HEADER_BLOCKLIST[lower_name] and not connection_headers[lower_name] then
            reply:add_header(name, value)
            has_content_type = has_content_type or lower_name == "content-type"
        end
    end
    return has_content_type
end

local function reply_with(txn, status, head, body)
    local reply = txn:reply()
    reply:set_status(status)
    if not copy_response_headers(reply, head) then
        reply:add_header("content-type", "text/plain")
    end
    reply:set_body(body)
    txn:done(reply)
end

local function fail(txn, reason)
    txn:set_var("txn.router_failed", reason)
end

-- use-server skips a DOWN server and load-balances, so reject it here.
local function server_is_up(backend_name, server_name)
    local ok, up = pcall(function()
        local status = core.backends[backend_name].servers[server_name]:get_stats()["status"]
        return not (status:find("^DOWN") or status:find("^MAINT"))
    end)
    return not ok or up
end

local function moved_path(path, from_prefix, to_prefix)
    local suffix = path
    if from_prefix ~= "/" then
        suffix = path:sub(#from_prefix + 1)
    end
    if to_prefix == "/" then
        return suffix ~= "" and suffix or "/"
    end
    return to_prefix .. suffix
end

local function route(txn, router)
    local body = txn.sf:req_body() or ""
    local hdrs = txn.http:req_get_headers()
    local headers = header_line("Content-Type", first_header(hdrs, "content-type"))
        .. header_line(REQUEST_ID_HEADER, first_header(hdrs, REQUEST_ID_HEADER))
        .. header_line(SESSION_HEADER, session_id_from(hdrs))
        .. header_line(ORIGINAL_METHOD_HEADER, txn.sf:method())
        .. header_line(REQUEST_PATH_HEADER, txn.sf:path())
    local truncated = truncated_full_length(txn, body)
    if truncated then
        headers = headers .. "X-Body-Truncated: " .. #body .. "/" .. truncated .. "\r\n"
    end
    local request = {headers = headers, body = body}

    local pool = router.pool
    local n = #pool
    local start = _rr_cursor[router.app] or 0
    _rr_cursor[router.app] = start + 1
    local response, reason
    for i = 0, n - 1 do
        response, reason = call_router(pool[(start + i) % n + 1], request)
        if response or reason ~= "router_unreachable" then
            break
        end
    end
    if not response then
        return fail(txn, reason)
    end

    local status, head, response_body = parse_response(response)
    if not status then
        return fail(txn, "malformed_decision")
    end
    if response_header(head, DIRECT_RESPONSE_HEADER) == "1" then
        return reply_with(txn, status, head, response_body)
    end
    if status < 200 or status > 299 then
        return reply_with(txn, status, head, response_body)
    end
    if status ~= 200 then
        return fail(txn, "malformed_decision")
    end

    local app_name = json_string_field(response_body, "application")
    local replica_id = json_string_field(response_body, "replica_id")
    if not app_name or not replica_id then
        return fail(txn, "malformed_decision")
    end
    txn:set_var("txn.serve_app", app_name)
    local target = APPS[app_name]
    if not target then
        return fail(txn, "unknown_application")
    end
    txn:set_var("txn.serve_deployment", target.d)
    local server_name = target.r[replica_id]
    if not server_name then
        return fail(txn, "unknown_replica_id")
    end
    if not server_is_up(target.b, server_name) then
        return fail(txn, "replica_unavailable")
    end

    txn.http:req_set_path(moved_path(txn.sf:path(), router.p, target.p))
    txn:set_var("txn.router_server", server_name)
    txn:set_var("txn.router_backend", target.b)
end

core.register_action("route_via_router_application", {"http-req"}, function(txn)
    local router_app = txn:get_var("txn.router_app")
    local router = router_app and ROUTERS[router_app]
    if not router or #router.pool == 0 then
        return fail(txn, "router_unavailable")
    end
    route(txn, router)
end, 0)
